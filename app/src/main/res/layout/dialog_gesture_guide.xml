<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_help"
            app:tint="#38BDF8"
            android:contentDescription="Gesture Guide" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="3D Model Viewer Controls"
            android:textColor="#F8FAFC"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnGuideClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_action_btn"
            android:src="@drawable/ic_close"
            android:padding="7dp"
            app:tint="#94A3B8"
            android:contentDescription="Close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#334155" />

    <!-- Mode 1: Normal Mode -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_model_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_normal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="📍 1. Normal Mode (Default)"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="• One-Finger Drag: Moves container smoothly across canvas\n• Two-Finger Pinch: Resizes container (3D model scales to fit)"
            android:textColor="#E2E8F0"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>

    <!-- Mode 2: Interaction Mode -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_model_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_interaction"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="🔄 2. 3D Interaction Mode"
            android:textColor="#10B981"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="• One-Finger Drag: Rotates 3D model (Yaw &amp; Pitch)\n• Two-Finger Pinch: Zooms 3D model in/out\n• Container is locked in place while interacting"
            android:textColor="#E2E8F0"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>

    <!-- Action Buttons Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_model_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔘 3. Action Buttons on Every Model"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="• 3D Button: Toggles Interaction Mode\n• Label Button: Shows/hides projected part labels with connector lines\n• Close Button: Removes model &amp; releases resources immediately"
            android:textColor="#CBD5E1"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

</LinearLayout>
